# Copy this file to terraform.tfvars and adjust values for your environment,
# including setting region to the AWS region where you want to deploy.

region = "us-east-1"
name   = "awseks"

kubernetes_version  = "1.33"
vpc_cidr            = "10.0.0.0/16"
az_count            = 3
enable_private_aws_api_endpoints = true
public_access_cidrs = ["0.0.0.0/0"]

node_instance_types = ["m6i.large"]
node_min_size       = 2
node_max_size       = 6
node_desired_size   = 2

tags = {
  owner = "platform"
}

# Standalone SSH/Docker EC2 instance.
ec2_enabled       = true
ec2_instance_type = "t3.small"
# SSH source CIDRs. Defaults to 0.0.0.0/0 (open to all); restrict to specific
# CIDR(s), e.g. ["203.0.113.4/32"], to reduce exposure.
ec2_ssh_ingress_cidrs = ["0.0.0.0/0"]
ec2_root_volume_size  = 30

gitops_repository_url    = "https://github.com/cfallwell/aws_eks.git"
gitops_repository_branch = "main"
gitops_repository_username = ""
gitops_repository_password = ""
signalfx_otel_enabled    = false
signalfx_otel_namespace  = "monitoring"
signalfx_otel_cluster_name = "awseks"
signalfx_observability_realm = ""
signalfx_observability_access_token = ""
signalfx_platform_endpoint = ""
signalfx_platform_hec_token = ""
signalfx_otel_secret_name = "signalfx-otel-credentials"

spa_demo_s3_bucket_name = ""
spa_demo_storage_size   = "20Gi"
spa_demo_host           = ""

spa_demo_db_name              = "spademo"
spa_demo_db_username          = "spademo"
spa_demo_db_instance_class    = "db.t4g.micro"
spa_demo_db_allocated_storage = 20
