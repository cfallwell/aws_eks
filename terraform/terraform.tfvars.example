# Copy this file to terraform.tfvars and adjust values for your environment,
# including setting region to the AWS region where you want to deploy.

region = "us-east-1"
name   = "awseks"

kubernetes_version  = "1.33"
vpc_cidr            = "10.0.0.0/16"
az_count            = 3
public_access_cidrs = ["0.0.0.0/0"]

node_instance_types = ["m6i.large"]
node_min_size       = 2
node_max_size       = 6
node_desired_size   = 2

tags = {
  owner = "platform"
}

flux_repository_url    = "https://github.com/cfallwell/aws_eks.git"
flux_repository_branch = "main"

spa_demo_s3_bucket_name = ""
spa_demo_storage_size   = "20Gi"
spa_demo_host           = ""

splunk_otel_suspend                 = true
splunk_otel_cluster_name            = ""
splunk_observability_realm          = ""
splunk_observability_access_token   = ""
splunk_platform_endpoint            = ""
splunk_platform_token               = ""

spa_demo_db_name              = "spademo"
spa_demo_db_username          = "spademo"
spa_demo_db_instance_class    = "db.t4g.micro"
spa_demo_db_allocated_storage = 20
