#cloud-config
# Managed by Terraform (terraform/ec2.tf). Provisions two password-based SSH
# logins and installs Docker on Amazon Linux 2023.
package_update: true
package_upgrade: false

# Ask cloud-init to enable SSH password authentication (cloud images disable it
# by default). A runcmd below also enforces it as belt-and-suspenders.
ssh_pwauth: true

packages:
  - docker

users:
  - default
  # Admin account: full sudo (member of the wheel group) + explicit sudoers rule.
  - name: ${admin_username}
    shell: /bin/bash
    groups: [wheel]
    sudo: "ALL=(ALL:ALL) ALL"
    lock_passwd: false
  # Standard (non-privileged) account.
  - name: ${user_username}
    shell: /bin/bash
    lock_passwd: false

runcmd:
  # Set the randomly generated passwords via chpasswd directly. This works on
  # every cloud-init version (unlike the newer structured chpasswd schema), and
  # the passwords never contain a ':' or single quote, so the quoting is safe.
  # jsonencode() produces a valid, fully quoted YAML/shell string.
  - ${jsonencode(format("echo '%s:%s' | chpasswd", admin_username, admin_password))}
  - ${jsonencode(format("echo '%s:%s' | chpasswd", user_username, user_password))}
  # Force-enable SSH password authentication and restart sshd so it takes effect.
  - printf 'PasswordAuthentication yes\nKbdInteractiveAuthentication yes\n' > /etc/ssh/sshd_config.d/60-enable-passwords.conf
  - systemctl restart sshd
  # Start Docker and grant both accounts access to the daemon socket. The docker
  # group is created by the docker package, so add membership here (after the
  # package install) rather than at user-creation time.
  - systemctl enable --now docker
  - usermod -aG docker ${admin_username}
  - usermod -aG docker ${user_username}
