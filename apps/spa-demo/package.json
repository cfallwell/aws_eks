{
  "name": "spa-demo",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --minify --platform=node --format=cjs --outfile=dist/server.cjs && npm run sync-dist",
    "sync-dist": "node scripts/sync-dist.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@cfallwell/rumbootstrap": "3.0.0",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "vite": "^5.4.14"
  }
}
